# Yosys synthesis script for I2C Top

# Read RTL
read_verilog -sv rtl/i2c_master.sv
read_verilog -sv rtl/i2c_slave.sv
read_verilog -sv rtl/i2c_top.sv

# Set top module
hierarchy -top i2c_top

# Generic synthesis
proc
opt
fsm
opt
memory
opt
techmap
opt

# Statistics
stat

# Write synthesized netlist
write_verilog reports/i2c_top_synth.v